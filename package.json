{
  "name": "mmx-code-explorer",
  "displayName": "Code Explorer",
  "description": "Multi-language Class Explorer with visual member creation, refactoring, and header/source management",
  "version": "0.1.5",
  "publisher": "mmx",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Refactoring",
    "Other"
  ],
  "keywords": [
    "class explorer",
    "code explorer",
    "method creator",
    "refactoring",
    "header source",
    "pascal",
    "delphi",
    "c++",
    "multi-language"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:pascal",
    "onLanguage:cpp",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:python",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:plsql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mmx-explorer",
          "title": "Code Explorer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mmx-explorer": [
        {
          "id": "mmxTemplates",
          "name": "Templates",
          "when": "mmx:isActive",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "mmxViewer",
          "name": "Member",
          "when": "mmx:isActive",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "mmx.addMethod",
        "title": "CE: Add Method...",
        "icon": "$(add)"
      },
      {
        "command": "mmx.addField",
        "title": "CE: Add Field...",
        "icon": "$(symbol-field)"
      },
      {
        "command": "mmx.addProperty",
        "title": "CE: Add Property...",
        "icon": "$(symbol-property)"
      },
      {
        "command": "mmx.addConstructor",
        "title": "CE: Add Constructor...",
        "icon": "$(symbol-constructor)"
      },
      {
        "command": "mmx.refreshExplorer",
        "title": "CE: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "mmx.navigateToMember",
        "title": "CE: Navigate to Member"
      },
      {
        "command": "mmx.synchronizeDeclImpl",
        "title": "CE: Synchronize Declaration/Implementation"
      },
      {
        "command": "mmx.editMember",
        "title": "CE: Edit Member...",
        "icon": "$(edit)"
      },
      {
        "command": "mmx.deleteMember",
        "title": "CE: Delete Member",
        "icon": "$(trash)"
      },
      {
        "command": "mmx.moveMember",
        "title": "CE: Move Member to..."
      },
      {
        "command": "mmx.extractMethod",
        "title": "CE: Extract Method"
      },
      {
        "command": "mmx.renameMember",
        "title": "CE: Rename Member",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "mmx.createLocalVariable",
        "title": "CE: Create Local Variable"
      },
      {
        "command": "mmx.renameLocalVariable",
        "title": "CE: Rename Local Variable"
      },
      {
        "command": "mmx.changeLocalType",
        "title": "CE: Change Local Type"
      },
      {
        "command": "mmx.declareLocalVariable",
        "title": "CE: Declare Local Variable"
      },
      {
        "command": "mmx.renameVariable",
        "title": "CE: Rename Variable",
        "icon": "$(edit)"
      },
      {
        "command": "mmx.changeVariableType",
        "title": "CE: Change Variable Type"
      },
      {
        "command": "mmx.deleteVariable",
        "title": "CE: Delete Variable",
        "icon": "$(trash)"
      },
      {
        "command": "mmx.openMemberEditor",
        "title": "CE: Open Member Editor",
        "icon": "$(edit)"
      },
      {
        "command": "mmx.showActions",
        "title": "CE: Show Actions"
      },
      {
        "command": "mmx.insertTemplate",
        "title": "CE: Insert Template..."
      },
      {
        "command": "mmx.manageTemplates",
        "title": "CE: Manage Templates...",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "mmx.implementInterface",
        "title": "CE: Implement Interface / Override Methods...",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "mmx.filterTree",
        "title": "CE: Filter Members...",
        "icon": "$(filter)"
      },
      {
        "command": "mmx.clearFilter",
        "title": "CE: Clear Member Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "mmx.toggleGroupBy",
        "title": "CE: Toggle Member Grouping",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "mmx.goToMember",
        "title": "CE: Go to Member..."
      },
      {
        "command": "mmx.generateGettersSetters",
        "title": "Code Explorer: Generate Getters/Setters...",
        "icon": "$(symbol-property)"
      },
      {
        "command": "mmx.insertDocHeader",
        "title": "CE: Insert Doc Header",
        "icon": "$(symbol-string)"
      },
      {
        "command": "ce.exportStructure",
        "title": "CE: Export Structure"
      },
      {
        "command": "ce.generateDocumentation",
        "title": "CE: Generate Documentation"
      },
      {
        "command": "ce.codeReview",
        "title": "CE: Code Review"
      },
      {
        "command": "ce.detectDeadCode",
        "title": "CE: Detect Dead Code"
      },
      {
        "command": "ce.batchMove",
        "title": "CE: Batch Move Members..."
      },
      {
        "command": "ce.batchGenerateGettersSetters",
        "title": "CE: Batch Generate Getters/Setters..."
      },
      {
        "command": "mmx.manageMembers",
        "title": "CE: Manage Members (Add / Delete)",
        "icon": "$(list-tree)"
      },
      {
        "command": "mmx.lensRun",
        "title": "CE: Run on Code Lens target"
      },
      {
        "command": "mmx.goToWorkspaceMember",
        "title": "CE: Go to Member in Workspace..."
      },
      {
        "command": "mmx.alignSelection",
        "title": "CE: Align Selection on Text..."
      },
      {
        "command": "mmx.addComponent",
        "title": "CE: Add Delphi Component (.pas + .dfm)..."
      },
      {
        "command": "mmx.addEventHandler",
        "title": "CE: Add Event Handler to Delphi Component..."
      },
      {
        "command": "mmx.plsql.syncPackage",
        "title": "CE PL/SQL: Synchronize Package Spec / Body"
      },
      {
        "command": "mmx.plsql.newPackage",
        "title": "CE PL/SQL: New Package..."
      },
      {
        "command": "mmx.plsql.crudFromTable",
        "title": "CE PL/SQL: CRUD Package from CREATE TABLE"
      },
      {
        "command": "mmx.plsql.utplsql",
        "title": "CE PL/SQL: Generate utPLSQL Tests from Spec"
      },
      {
        "command": "mmx.plsql.exceptionBlock",
        "title": "CE PL/SQL: Insert Exception Block"
      },
      {
        "command": "mmx.plsql.extractProcedure",
        "title": "CE PL/SQL: Extract Procedure from Selection"
      },
      {
        "command": "mmx.plsql.docHeader",
        "title": "CE PL/SQL: Insert / Refresh PLDoc Header"
      },
      {
        "command": "mmx.plsql.findCallers",
        "title": "CE PL/SQL: Find Callers"
      },
      {
        "command": "mmx.plsql.alignPreset",
        "title": "CE PL/SQL: Align Selection (preset)"
      },
      {
        "command": "mmx.delphi.align",
        "title": "CE Delphi: Align / Size / Space Components..."
      },
      {
        "command": "mmx.delphi.anchors",
        "title": "CE Delphi: Anchors / Docking..."
      },
      {
        "command": "mmx.delphi.tabOrder",
        "title": "CE Delphi: TabOrder by Screen Position..."
      },
      {
        "command": "mmx.delphi.check",
        "title": "CE Delphi: Check Form (.dfm vs .pas)"
      },
      {
        "command": "mmx.delphi.cleanHandlers",
        "title": "CE Delphi: Clean Event Handlers"
      },
      {
        "command": "mmx.delphi.copy",
        "title": "CE Delphi: Copy Components..."
      },
      {
        "command": "mmx.delphi.paste",
        "title": "CE Delphi: Paste Components..."
      },
      {
        "command": "mmx.delphi.duplicate",
        "title": "CE Delphi: Duplicate Components..."
      },
      {
        "command": "mmx.delphi.formFromFields",
        "title": "CE Delphi: Form from Fields..."
      },
      {
        "command": "mmx.delphi.formFromClass",
        "title": "CE Delphi: Form from a Class..."
      },
      {
        "command": "mmx.delphi.changeClass",
        "title": "CE Delphi: Change Component Class..."
      },
      {
        "command": "mmx.delphi.designer",
        "title": "CE Delphi: Open Form Designer / Back to the Designer",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "mmx.delphi.toggleDesigner",
        "title": "CE Delphi: Toggle Form Designer / Code (like F12 in Delphi)",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "mmx.memo.open",
        "title": "CE: Open Memo (Markdown notes per language)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mmx.showActions",
          "group": "mmx@0"
        },
        {
          "command": "mmx.manageMembers",
          "when": "editorTextFocus",
          "group": "mmx@0"
        },
        {
          "command": "mmx.editMember",
          "when": "editorTextFocus",
          "group": "mmx@1"
        },
        {
          "command": "mmx.renameVariable",
          "when": "editorTextFocus",
          "group": "mmx@2"
        },
        {
          "command": "mmx.changeVariableType",
          "when": "editorTextFocus",
          "group": "mmx@3"
        },
        {
          "command": "mmx.deleteVariable",
          "when": "editorTextFocus",
          "group": "mmx@4"
        },
        {
          "command": "mmx.extractMethod",
          "when": "editorTextFocus",
          "group": "mmx@5"
        },
        {
          "command": "mmx.implementInterface",
          "when": "editorTextFocus",
          "group": "mmx@6"
        },
        {
          "command": "mmx.alignSelection",
          "when": "editorHasSelection",
          "group": "mmx@7"
        }
      ],
      "commandPalette": [
        {
          "command": "mmx.navigateToMember",
          "when": "false"
        },
        {
          "command": "mmx.lensRun",
          "when": "false"
        },
        {
          "command": "mmx.plsql.alignPreset",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mmx.delphi.designer",
          "when": "resourceExtname =~ /^\\.(pas|dfm)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Code Explorer",
      "properties": {
        "mmx.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Code Lens annotations above classes and methods"
        },
        "mmx.pascal.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Indentation size for generated Pascal code"
        },
        "mmx.cpp.indentSize": {
          "type": "number",
          "default": 4,
          "description": "Indentation size for generated C++ code"
        },
        "mmx.cpp.braceStyle": {
          "type": "string",
          "enum": [
            "sameLine",
            "newLine"
          ],
          "default": "newLine",
          "description": "Brace placement style for generated C++ code"
        },
        "mmx.pascal.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "protected",
            "public",
            "published"
          ],
          "default": "private",
          "description": "Default visibility for new Pascal members"
        },
        "mmx.cpp.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "protected",
            "public"
          ],
          "default": "private",
          "description": "Default visibility for new C++ members"
        },
        "mmx.sorting.scheme": {
          "type": "string",
          "enum": [
            "fieldsFirst",
            "methodsFirst",
            "visibilityGrouped"
          ],
          "default": "fieldsFirst",
          "description": "Default sorting scheme for class members"
        },
        "mmx.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize declaration/implementation on save"
        },
        "mmx.previewEdits": {
          "type": "boolean",
          "default": false,
          "description": "Show a diff preview and ask for confirmation before applying any structural edit (Safe Preview)"
        },
        "mmx.codeLensMemberActions": {
          "type": "boolean",
          "default": false,
          "description": "Show Edit / Delete code lenses above every member (in addition to the class-level Add / Delete lens)"
        },
        "mmx.delphi.customComponents": {
          "type": "array",
          "default": [],
          "description": "Third-party Delphi components (DevExpress, TMS, JVCL, Raize…) the Add Component tool should know: className, unit, width, height, namePrefix, events, props, tabOrder. Classes not listed here are learned from the .dfm files of the workspace.",
          "items": {
            "type": "object",
            "required": [
              "className"
            ],
            "properties": {
              "className": {
                "type": "string",
                "description": "e.g. TcxButton"
              },
              "unit": {
                "type": "string",
                "description": "Unit added to uses, e.g. cxButtons"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "namePrefix": {
                "type": "string",
                "description": "Default name prefix, e.g. cxButton"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Events offered, e.g. [\"OnClick\"]"
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra DFM property lines, e.g. [\"Caption = '%NAME%'\"]"
              },
              "tabOrder": {
                "type": "boolean"
              }
            }
          }
        },
        "mmx.plsql.author": {
          "type": "string",
          "default": "",
          "description": "Author written in generated PL/SQL headers (default: the OS user name)."
        },
        "mmx.delphi.removeEmptyHandlers": {
          "type": "boolean",
          "default": true,
          "description": "On a manual save of a Delphi form unit, remove event handlers whose body is empty (method, declaration and the .dfm link), like the Delphi IDE. A body containing a comment is not empty."
        },
        "mmx.delphi.designerColumn": {
          "type": "string",
          "enum": [
            "active",
            "beside"
          ],
          "default": "active",
          "description": "Where the form designer opens: in the current editor group as another tab of the unit ('active', switch with the tab, the title-bar button or Ctrl+K Ctrl+B) or next to it ('beside')."
        },
        "mmx.memo.folder": {
          "type": "string",
          "default": "",
          "description": "Folder holding the Markdown memos, one file per language (typescript.md, pascal.md, plsql.md, general.md…). Empty: the extension's own storage. A relative path is taken from the workspace folder, so the memos can be versioned with the project."
        }
      }
    },
    "keybindings": [
      {
        "command": "mmx.manageMembers",
        "key": "ctrl+k ctrl+m",
        "when": "editorTextFocus && resourceExtname =~ /^.(pas|dpr|dpk|cpp|cc|cxx|h|hpp|hxx|rs|java|py|cs|go|ts|tsx|js|jsx|pks|pkb|sql)$/"
      },
      {
        "command": "mmx.showActions",
        "key": "ctrl+k ctrl+a",
        "when": "editorTextFocus && resourceExtname =~ /^.(pas|dpr|dpk|cpp|cc|cxx|h|hpp|hxx|rs|java|py|cs|go|ts|tsx|js|jsx|pks|pkb|sql)$/"
      },
      {
        "command": "mmx.editMember",
        "key": "ctrl+k ctrl+e",
        "when": "editorTextFocus && resourceExtname =~ /^.(pas|dpr|dpk|cpp|cc|cxx|h|hpp|hxx|rs|java|py|cs|go|ts|tsx|js|jsx|pks|pkb|sql)$/"
      },
      {
        "command": "mmx.delphi.toggleDesigner",
        "key": "ctrl+k ctrl+b",
        "when": "(editorTextFocus && resourceExtname =~ /^\\.(pas|dfm)$/i) || activeWebviewPanelId == 'mmxFormDesigner'"
      },
      {
        "command": "mmx.delphi.designer",
        "key": "ctrl+k d",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.align",
        "key": "ctrl+k l",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.anchors",
        "key": "ctrl+k n",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.tabOrder",
        "key": "ctrl+k t",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.check",
        "key": "ctrl+k c",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.cleanHandlers",
        "key": "ctrl+k h",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.copy",
        "key": "ctrl+k y",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.paste",
        "key": "ctrl+k a",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.duplicate",
        "key": "ctrl+k k",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.formFromFields",
        "key": "ctrl+k g",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.formFromClass",
        "key": "ctrl+k q",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.delphi.changeClass",
        "key": "ctrl+k e",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "mmx.plsql.syncPackage",
        "key": "ctrl+k y",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.newPackage",
        "key": "ctrl+k n",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.crudFromTable",
        "key": "ctrl+k c",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.extractProcedure",
        "key": "ctrl+k x",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.exceptionBlock",
        "key": "ctrl+k e",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.docHeader",
        "key": "ctrl+k d",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.utplsql",
        "key": "ctrl+k t",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.plsql.findCallers",
        "key": "ctrl+k l",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb|txt)$/i"
      },
      {
        "command": "mmx.alignSelection",
        "key": "ctrl+k j",
        "when": "editorTextFocus"
      },
      {
        "command": "mmx.memo.open",
        "key": "ctrl+k ctrl+n",
        "when": "editorTextFocus || sideBarFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "eslint src --ext ts",
    "compile": "tsc --noEmit",
    "test": "node --import tsx --test src/test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  }
}
