{
  "name": "ce-code-explorer",
  "displayName": "Code Explorer",
  "icon": "media/icon.png",
  "description": "Multi-language Class Explorer with visual member creation, refactoring, and header/source management",
  "version": "0.1.48",
  "publisher": "ce",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Refactoring",
    "Other"
  ],
  "keywords": [
    "class explorer",
    "code explorer",
    "method creator",
    "refactoring",
    "header source",
    "pascal",
    "delphi",
    "c++",
    "multi-language"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:pascal",
    "onLanguage:cpp",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:python",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:plsql",
    "onLanguage:bat",
    "onLanguage:powershell",
    "onLanguage:shellscript",
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ce-explorer",
          "title": "Code Explorer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ce-explorer": [
        {
          "id": "ceTemplates",
          "name": "Templates",
          "when": "ce:isActive",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "ceViewer",
          "name": "Member",
          "when": "ce:isActive",
          "type": "webview"
        },
        {
          "id": "ceGuideView",
          "name": "Changelog + Guide",
          "when": "ce:isActive",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "ce.addMethod",
        "title": "CE: Add Method...",
        "icon": "$(add)"
      },
      {
        "command": "ce.addField",
        "title": "CE: Add Field...",
        "icon": "$(symbol-field)"
      },
      {
        "command": "ce.addProperty",
        "title": "CE: Add Property...",
        "icon": "$(symbol-property)"
      },
      {
        "command": "ce.addConstructor",
        "title": "CE: Add Constructor...",
        "icon": "$(symbol-constructor)"
      },
      {
        "command": "ce.refreshExplorer",
        "title": "CE: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "ce.navigateToMember",
        "title": "CE: Navigate to Member"
      },
      {
        "command": "ce.synchronizeDeclImpl",
        "title": "CE: Synchronize Declaration/Implementation"
      },
      {
        "command": "ce.editMember",
        "title": "CE: Edit Member...",
        "icon": "$(edit)"
      },
      {
        "command": "ce.deleteMember",
        "title": "CE: Delete Member",
        "icon": "$(trash)"
      },
      {
        "command": "ce.moveMember",
        "title": "CE: Move Member to..."
      },
      {
        "command": "ce.extractMethod",
        "title": "CE: Extract Method"
      },
      {
        "command": "ce.renameMember",
        "title": "CE: Rename Member",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "ce.createLocalVariable",
        "title": "CE: Create Local Variable"
      },
      {
        "command": "ce.renameLocalVariable",
        "title": "CE: Rename Local Variable"
      },
      {
        "command": "ce.changeLocalType",
        "title": "CE: Change Local Type"
      },
      {
        "command": "ce.declareLocalVariable",
        "title": "CE: Declare Local Variable"
      },
      {
        "command": "ce.renameVariable",
        "title": "CE: Rename Variable",
        "icon": "$(edit)"
      },
      {
        "command": "ce.changeVariableType",
        "title": "CE: Change Variable Type"
      },
      {
        "command": "ce.deleteVariable",
        "title": "CE: Delete Variable",
        "icon": "$(trash)"
      },
      {
        "command": "ce.openMemberEditor",
        "title": "CE: Open Member Editor",
        "icon": "$(edit)"
      },
      {
        "command": "ce.showActions",
        "title": "CE: Show Actions"
      },
      {
        "command": "ce.insertTemplate",
        "title": "CE: Insert Template..."
      },
      {
        "command": "ce.manageTemplates",
        "title": "CE: Manage Templates...",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "ce.implementInterface",
        "title": "CE: Implement Interface / Override Methods...",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "ce.filterTree",
        "title": "CE: Filter Members...",
        "icon": "$(filter)"
      },
      {
        "command": "ce.clearFilter",
        "title": "CE: Clear Member Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "ce.toggleGroupBy",
        "title": "CE: Toggle Member Grouping",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "ce.goToMember",
        "title": "CE: Go to Member..."
      },
      {
        "command": "ce.generateGettersSetters",
        "title": "Code Explorer: Generate Getters/Setters...",
        "icon": "$(symbol-property)"
      },
      {
        "command": "ce.insertDocHeader",
        "title": "CE: Insert Doc Header",
        "icon": "$(symbol-string)"
      },
      {
        "command": "ce.exportStructure",
        "title": "CE: Export Structure"
      },
      {
        "command": "ce.generateDocumentation",
        "title": "CE: Generate Documentation"
      },
      {
        "command": "ce.codeReview",
        "title": "CE: Code Review"
      },
      {
        "command": "ce.detectDeadCode",
        "title": "CE: Detect Dead Code"
      },
      {
        "command": "ce.batchMove",
        "title": "CE: Batch Move Members..."
      },
      {
        "command": "ce.batchGenerateGettersSetters",
        "title": "CE: Batch Generate Getters/Setters..."
      },
      {
        "command": "ce.manageMembers",
        "title": "CE: Open Structure (add, filter, edit, move, delete members)",
        "icon": "$(list-tree)"
      },
      {
        "command": "ce.lensRun",
        "title": "CE: Run on Code Lens target"
      },
      {
        "command": "ce.goToWorkspaceMember",
        "title": "CE: Go to Member in Workspace..."
      },
      {
        "command": "ce.alignSelection",
        "title": "CE: Align Selection on Text..."
      },
      {
        "command": "ce.addComponent",
        "title": "CE: Add Delphi Component (.pas + .dfm)..."
      },
      {
        "command": "ce.addEventHandler",
        "title": "CE: Add Event Handler to Delphi Component..."
      },
      {
        "command": "ce.plsql.syncPackage",
        "title": "CE PL/SQL: Synchronize Package Spec / Body"
      },
      {
        "command": "ce.plsql.newPackage",
        "title": "CE PL/SQL: New Package..."
      },
      {
        "command": "ce.plsql.sqlFromTable",
        "title": "CE PL/SQL: SELECT / INSERT / UPDATE / DELETE / MERGE from CREATE TABLE"
      },
      {
        "command": "ce.plsql.utplsql",
        "title": "CE PL/SQL: Generate utPLSQL Tests from Spec"
      },
      {
        "command": "ce.plsql.exceptionBlock",
        "title": "CE PL/SQL: Insert Exception Block"
      },
      {
        "command": "ce.plsql.extractProcedure",
        "title": "CE PL/SQL: Extract Procedure from Selection"
      },
      {
        "command": "ce.plsql.docHeader",
        "title": "CE PL/SQL: Insert / Refresh PLDoc Header"
      },
      {
        "command": "ce.plsql.findCallers",
        "title": "CE PL/SQL: Find Callers"
      },
      {
        "command": "ce.plsql.alignPreset",
        "title": "CE PL/SQL: Align Selection (preset)"
      },
      {
        "command": "ce.delphi.align",
        "title": "CE Delphi: Align / Size / Space Components..."
      },
      {
        "command": "ce.delphi.anchors",
        "title": "CE Delphi: Anchors / Docking..."
      },
      {
        "command": "ce.delphi.tabOrder",
        "title": "CE Delphi: TabOrder by Screen Position..."
      },
      {
        "command": "ce.delphi.check",
        "title": "CE Delphi: Check Form (.dfm vs .pas)"
      },
      {
        "command": "ce.delphi.cleanHandlers",
        "title": "CE Delphi: Clean Event Handlers"
      },
      {
        "command": "ce.delphi.copy",
        "title": "CE Delphi: Copy Components..."
      },
      {
        "command": "ce.delphi.paste",
        "title": "CE Delphi: Paste Components..."
      },
      {
        "command": "ce.delphi.duplicate",
        "title": "CE Delphi: Duplicate Components..."
      },
      {
        "command": "ce.delphi.formFromFields",
        "title": "CE Delphi: Form from Fields..."
      },
      {
        "command": "ce.delphi.formFromClass",
        "title": "CE Delphi: Form from a Class..."
      },
      {
        "command": "ce.delphi.changeClass",
        "title": "CE Delphi: Change Component Class..."
      },
      {
        "command": "ce.setLanguage",
        "title": "CE: Use a Language for this File..."
      },
      {
        "command": "ce.fixEncoding",
        "title": "CE: Fix Encoding (accents)...",
        "icon": "$(warning)"
      },
      {
        "command": "ce.delphi.project",
        "title": "CE: Project Insights (SQL, dead code, size, hotspots, Delphi forms)"
      },
      {
        "command": "ce.delphi.diffForm",
        "title": "CE Delphi: Compare the Form with a Git Version"
      },
      {
        "command": "ce.delphi.designer",
        "title": "CE Delphi: Open Form Designer / Back to the Designer",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "ce.delphi.toggleDesigner",
        "title": "CE Delphi: Toggle Form Designer / Code (like F12 in Delphi)",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "ce.memo.open",
        "title": "CE: Open Memo (Markdown notes per language)"
      },
      {
        "command": "ce.delphi.designerFullScreen",
        "title": "CE Delphi: Toggle form designer / blueprint full screen"
      },
      {
        "command": "ce.openGuide",
        "title": "CE: Open the User Guide (pictures and animations)"
      },
      {
        "command": "ce.blueprint.open",
        "title": "CE: Blueprint (the calls of this file as a graph you can edit)"
      },
      {
        "command": "ce.nav.nextMember",
        "title": "CE: Next member"
      },
      {
        "command": "ce.nav.prevMember",
        "title": "CE: Previous member"
      },
      {
        "command": "ce.nav.toggleDeclImpl",
        "title": "CE: Declaration <-> implementation"
      },
      {
        "command": "ce.nav.pickMember",
        "title": "CE: Go to a member (type a few letters)"
      }
    ],
    "submenus": [
      {
        "id": "ce.editorMenu",
        "label": "Code Explorer"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "ce.editorMenu",
          "group": "ce@0"
        }
      ],
      "ce.editorMenu": [
        {
          "command": "ce.showActions",
          "group": "0_quick@1"
        },
        {
          "command": "ce.manageMembers",
          "when": "editorTextFocus",
          "group": "1_navigate@1"
        },
        {
          "command": "ce.goToMember",
          "when": "editorTextFocus",
          "group": "1_navigate@2"
        },
        {
          "command": "ce.goToWorkspaceMember",
          "when": "editorTextFocus",
          "group": "1_navigate@3"
        },
        {
          "command": "ce.editMember",
          "when": "editorTextFocus",
          "group": "2_edit@1"
        },
        {
          "command": "ce.renameVariable",
          "when": "editorTextFocus",
          "group": "2_edit@2"
        },
        {
          "command": "ce.changeVariableType",
          "when": "editorTextFocus",
          "group": "2_edit@3"
        },
        {
          "command": "ce.deleteVariable",
          "when": "editorTextFocus",
          "group": "2_edit@4"
        },
        {
          "command": "ce.extractMethod",
          "when": "editorTextFocus",
          "group": "2_edit@5"
        },
        {
          "command": "ce.implementInterface",
          "when": "editorTextFocus",
          "group": "2_edit@6"
        },
        {
          "command": "ce.insertTemplate",
          "when": "editorTextFocus",
          "group": "2_edit@7"
        },
        {
          "command": "ce.alignSelection",
          "when": "editorHasSelection",
          "group": "2_edit@8"
        },
        {
          "command": "ce.codeReview",
          "when": "editorTextFocus",
          "group": "3_review@1"
        },
        {
          "command": "ce.detectDeadCode",
          "when": "editorTextFocus",
          "group": "3_review@2"
        },
        {
          "command": "ce.delphi.designer",
          "when": "resourceExtname =~ /^\\.(pas|dfm|dpr)$/i",
          "group": "4_delphi@1"
        },
        {
          "command": "ce.delphi.check",
          "when": "resourceExtname =~ /^\\.(pas|dfm|dpr)$/i",
          "group": "4_delphi@2"
        },
        {
          "command": "ce.delphi.cleanHandlers",
          "when": "resourceExtname =~ /^\\.(pas|dfm|dpr)$/i",
          "group": "4_delphi@3"
        },
        {
          "command": "ce.delphi.diffForm",
          "when": "resourceExtname =~ /^\\.(pas|dfm|dpr)$/i",
          "group": "4_delphi@4"
        },
        {
          "command": "ce.plsql.syncPackage",
          "when": "resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb)$/i",
          "group": "5_plsql@1"
        },
        {
          "command": "ce.plsql.extractProcedure",
          "when": "resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb)$/i",
          "group": "5_plsql@2"
        },
        {
          "command": "ce.plsql.docHeader",
          "when": "resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb)$/i",
          "group": "5_plsql@3"
        },
        {
          "command": "ce.plsql.findCallers",
          "when": "resourceExtname =~ /^\\.(pks|pkb|sql|pls|plb)$/i",
          "group": "5_plsql@4"
        },
        {
          "command": "ce.blueprint.open",
          "when": "editorTextFocus",
          "group": "1_navigate@8"
        },
        {
          "command": "ce.nav.pickMember",
          "when": "editorTextFocus",
          "group": "1_navigate@4"
        },
        {
          "command": "ce.nav.nextMember",
          "when": "editorTextFocus",
          "group": "1_navigate@5"
        },
        {
          "command": "ce.nav.prevMember",
          "when": "editorTextFocus",
          "group": "1_navigate@6"
        },
        {
          "command": "ce.nav.toggleDeclImpl",
          "when": "editorTextFocus",
          "group": "1_navigate@7"
        }
      ],
      "commandPalette": [
        {
          "command": "ce.navigateToMember",
          "when": "false"
        },
        {
          "command": "ce.lensRun",
          "when": "false"
        },
        {
          "command": "ce.plsql.alignPreset",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "ce.fixEncoding",
          "when": "ce:encodingSuspect",
          "group": "navigation@5"
        },
        {
          "command": "ce.delphi.designer",
          "when": "resourceExtname =~ /^\\.(pas|dfm)$/i",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ce.delphi.designer",
          "when": "resourceExtname =~ /^.(pas|dfm)$/i",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Code Explorer",
      "properties": {
        "ce.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Code Lens annotations above classes and methods"
        },
        "ce.pascal.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Indentation size for generated Pascal code"
        },
        "ce.cpp.indentSize": {
          "type": "number",
          "default": 4,
          "description": "Indentation size for generated C++ code"
        },
        "ce.cpp.braceStyle": {
          "type": "string",
          "enum": [
            "sameLine",
            "newLine"
          ],
          "default": "newLine",
          "description": "Brace placement style for generated C++ code"
        },
        "ce.pascal.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "protected",
            "public",
            "published"
          ],
          "default": "private",
          "description": "Default visibility for new Pascal members"
        },
        "ce.cpp.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "protected",
            "public"
          ],
          "default": "private",
          "description": "Default visibility for new C++ members"
        },
        "ce.sorting.scheme": {
          "type": "string",
          "enum": [
            "fieldsFirst",
            "methodsFirst",
            "visibilityGrouped"
          ],
          "default": "fieldsFirst",
          "description": "Default sorting scheme for class members"
        },
        "ce.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize declaration/implementation on save"
        },
        "ce.previewEdits": {
          "type": "boolean",
          "default": false,
          "description": "Show a diff preview and ask for confirmation before applying any structural edit (Safe Preview)"
        },
        "ce.codeLensMemberActions": {
          "type": "boolean",
          "default": false,
          "description": "Show Edit / Delete code lenses above every member (in addition to the class-level Structure lens)"
        },
        "ce.delphi.customComponents": {
          "type": "array",
          "default": [],
          "description": "Third-party Delphi components (DevExpress, TMS, JVCL, Raize…) the Add Component tool should know: className, unit, width, height, namePrefix, events, props, tabOrder. Classes not listed here are learned from the .dfm files of the workspace.",
          "items": {
            "type": "object",
            "required": [
              "className"
            ],
            "properties": {
              "className": {
                "type": "string",
                "description": "e.g. TcxButton"
              },
              "unit": {
                "type": "string",
                "description": "Unit added to uses, e.g. cxButtons"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "namePrefix": {
                "type": "string",
                "description": "Default name prefix, e.g. cxButton"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Events offered, e.g. [\"OnClick\"]"
              },
              "props": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra DFM property lines, e.g. [\"Caption = '%NAME%'\"]"
              },
              "tabOrder": {
                "type": "boolean"
              }
            }
          }
        },
        "ce.plsql.author": {
          "type": "string",
          "default": "",
          "description": "Author written in generated PL/SQL headers (default: the OS user name)."
        },
        "ce.delphi.removeEmptyHandlers": {
          "type": "boolean",
          "default": true,
          "description": "On a manual save of a Delphi form unit, remove event handlers whose body is empty (method, declaration and the .dfm link), like the Delphi IDE. A body containing a comment is not empty."
        },
        "ce.delphi.designerColumn": {
          "type": "string",
          "enum": [
            "active",
            "beside"
          ],
          "default": "active",
          "description": "Where the form designer opens: in the current editor group as another tab of the unit ('active', switch with the tab, the title-bar button or Ctrl+K Ctrl+B) or next to it ('beside')."
        },
        "ce.delphi.hostCalls": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["fAddFormInto"],
          "description": "Names of the helpers of the project that put a form in a container, called as Helper(Form, Container) (they do Form.Parent := Container). The designer reads them, and `Form.Parent := Container`, to link a panel to the form it hosts."
        },
        "ce.delphi.designerAutoSave": {
          "type": "boolean",
          "default": false,
          "description": "Save the .dfm and the .pas after every change made in the form designer. Off by default: the Save button (Ctrl+S in the designer) saves both files together."
        },
        "ce.delphi.namingPrefixes": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "markdownDescription": "Prefix of the components of a class, for the *Names* tab of the project panel: `{ \"TButton\": \"btn\", \"TcxGridDBTableView\": \"cxgtv\" }`. A class that is not listed follows what the project already does (the prefix most of its components carry)."
        },
        "ce.memo.folder": {
          "type": "string",
          "default": "",
          "description": "Folder holding the Markdown memos, one file per language (typescript.md, pascal.md, plsql.md, general.md…). Empty: the extension's own storage. A relative path is taken from the workspace folder, so the memos can be versioned with the project."
        }
      }
    },
    "keybindings": [
      {
        "command": "ce.manageMembers",
        "key": "ctrl+k ctrl+m",
        "when": "editorTextFocus && resourceExtname =~ /^.(pas|dpr|dpk|cpp|cc|cxx|h|hpp|hxx|rs|java|py|cs|go|ts|tsx|js|jsx|pks|pkb|sql)$/"
      },
      {
        "command": "ce.showActions",
        "key": "ctrl+k ctrl+a",
        "when": "editorTextFocus && resourceExtname =~ /^.(pas|dpr|dpk|cpp|cc|cxx|h|hpp|hxx|rs|java|py|cs|go|ts|tsx|js|jsx|pks|pkb|sql)$/"
      },
      {
        "command": "ce.editMember",
        "key": "ctrl+k ctrl+e",
        "when": "editorTextFocus && resourceExtname =~ /^.(pas|dpr|dpk|cpp|cc|cxx|h|hpp|hxx|rs|java|py|cs|go|ts|tsx|js|jsx|pks|pkb|sql)$/"
      },
      {
        "command": "ce.delphi.toggleDesigner",
        "key": "ctrl+k ctrl+b",
        "when": "(editorTextFocus && resourceExtname =~ /^\\.(pas|dfm)$/i) || activeWebviewPanelId == 'ceFormDesigner'"
      },
      {
        "command": "ce.nav.nextMember",
        "key": "ctrl+shift+down",
        "when": "editorTextFocus"
      },
      {
        "command": "ce.nav.prevMember",
        "key": "ctrl+shift+up",
        "when": "editorTextFocus"
      },
      {
        "command": "ce.nav.toggleDeclImpl",
        "key": "alt+enter",
        "when": "editorTextFocus && !findWidgetVisible && !suggestWidgetVisible"
      },
      {
        "command": "ce.nav.pickMember",
        "key": "alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "ce.delphi.designerFullScreen",
        "key": "ctrl+k ctrl+f",
        "when": "activeWebviewPanelId == 'ceFormDesigner' || activeWebviewPanelId == 'ceBlueprint'"
      },
      {
        "command": "ce.delphi.designer",
        "key": "ctrl+k d",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(pas|dfm|dpr)$/i"
      },
      {
        "command": "ce.delphi.align",
        "key": "ctrl+k l",
