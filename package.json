    "walkthroughs": [
      {
        "id": "ce.start",
        "title": "Get started with Code Explorer",
        "description": "Five short steps to move around your code, draw it, and find every command.",
        "steps": [
          {
            "id": "structure",
            "title": "See the structure of the file",
            "description": "The classes, methods and fields of the file you edit, one click away.\n[Show the structure](command:ce.manageMembers)",
            "media": {
              "markdown": "media/walkthrough/structure.md"
            },
            "completionEvents": [
              "onCommand:ce.manageMembers"
            ]
          },
          {
            "id": "jump",
            "title": "Move between members",
            "description": "Pick a member by typing a few letters, or walk through them with the keyboard.\n[Go to a member](command:ce.nav.pickMember)",
            "media": {
              "markdown": "media/walkthrough/jump.md"
            },
            "completionEvents": [
              "onCommand:ce.nav.pickMember",
              "onCommand:ce.nav.nextMember"
            ]
          },
          {
            "id": "blueprint",
            "title": "See your code as a graph",
            "description": "The calls of a file, or the units of a project, drawn as nodes you can edit.\n[Open the Blueprint](command:ce.blueprint.open)",
            "media": {
              "markdown": "media/walkthrough/blueprint.md"
            },
            "completionEvents": [
              "onCommand:ce.blueprint.open",
              "onCommand:ce.blueprint.project"
            ]
          },
          {
            "id": "actions",
            "title": "Everything in one menu",
            "description": "Every command that suits the file, with its shortcut.\n[Quick actions](command:ce.showActions)",
            "media": {
              "markdown": "media/walkthrough/actions.md"
            },
            "completionEvents": [
              "onCommand:ce.showActions"
            ]
          },
          {
            "id": "settings",
            "title": "Settings and guide",
            "description": "A few options, and a guide with pictures.\n[Open the settings](command:ce.openSettings)  [Open the guide](command:ce.openGuide)",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            },
            "completionEvents": [
              "onCommand:ce.openSettings",
              "onCommand:ce.openGuide"
            ]
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "ce.markdownEditor",
        "displayName": "Code Explorer Markdown (page)",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "eslint src --ext ts",
    "compile": "tsc --noEmit",
    "test": "node --import tsx --test src/test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0"
  }
}
